{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konsol",
  "version": "0.3.0",
  "identifier": "dev.qyrn.konsol",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Konsol",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.local/share/Steam/appcache/librarycache/**",
          "$HOME/.config/heroic/images-cache/**",
          "$APPCACHE/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Lance tous les jeux du PC"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MjI3QTQzNTJBODkyRkQKUldUOWtxaFNRM29pbGUzN3FZT1FRaWRJZHB6U2FOZFBBSmtCdFJCRkhvcE5VQ3REODlxL2ZiSVoK",
      "endpoints": [
        "https://github.com/qyrn/konsol/releases/latest/download/latest.json"
      ]
    }
  }
}
